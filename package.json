{
  "name": "arcom-v2",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "nx run-many -t dev --parallel=3",
    "dev:api": "nx dev api",
    "dev:pos": "nx dev pos-react",
    "dev:admin": "nx dev admin-panel",
    "dev:panel": "nx dev admin-panel",
    "dev:launcher": "nx dev arcom-launcher",
    "dev:landing": "nx dev marketing-landing",
    "dev:landing:direct": "cd apps/marketing-landing && npx astro dev",
    "build": "nx build api && nx build admin-panel && nx build pos-react && nx build arcom-launcher",
    "build:api": "nx build api",
    "build:pos": "nx build pos-react",
    "build:admin": "nx build admin-panel",
    "build:launcher": "nx build arcom-launcher",
    "build:landing": "nx build marketing-landing",
    "lint": "nx run-many -t lint",
    "check:landing": "nx check marketing-landing",
    "typecheck": "nx run-many -t typecheck",
    "prisma:generate": "nx run api:prisma:generate",
    "prisma:migrate": "nx run api:prisma:migrate",
    "prisma:studio": "nx run api:prisma:studio",
    "admin:prisma:generate": "nx run admin-panel:prisma:generate",
    "admin:prisma:push": "nx run admin-panel:prisma:push",
    "admin:prisma:studio": "nx run admin-panel:prisma:studio",
    "admin:seed": "nx run admin-panel:prisma:seed",
    "seed": "nx run api:prisma:seed",
    "e2e": "cd apps/pos-e2e && npx playwright test",
    "e2e:ui": "cd apps/pos-e2e && npx playwright test --ui",
    "e2e:debug": "cd apps/pos-e2e && npx playwright test --debug",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "^22.7.7",
    "@nx/js": "^22.3.0",
    "@nx/node": "^22.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "nx": "^22.3.0",
    "playwright": "^1.62.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
