generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                String   @id @default(cuid())
  name              String
  taxId             String   @unique
  address           String?
  email             String?
  phone             String?
  created_at        Int      @default(0)
  updated_at        Int
  config            String?

  stores            Store[]
  users             User[]
  products          Product[]
  product_variants  ProductVariant[]
  inventory         Inventory[]
  inventory_movements InventoryMovement[]
  sales             Sale[]
  contacts          Contact[]
  cash_registers    CashRegister[]
  cash_movements    CashMovement[]
  purchase_orders   PurchaseOrder[]
  purchase_receipts PurchaseReceipt[]
  wallet_transactions WalletTransaction[]
  tasks             Task[]
  transfers         Transfer[]
  invoices          Invoice[]
  cost_histories    CostHistory[]
  inventory_costs   InventoryCost[]

  @@map("companies")
}

model Store {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  address           String?
  phone             String?
  is_active         Boolean  @default(true)
  created_at        Int      @default(0)
  updated_at        Int

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products          Product[]
  inventory         Inventory[]
  inventory_movements InventoryMovement[]
  sales             Sale[]
  cash_registers    CashRegister[]
  cash_movements    CashMovement[]
  purchase_orders   PurchaseOrder[]
  purchase_receipts PurchaseReceipt[]
  tasks             Task[]
  transfers_from    Transfer[] @relation("transfer_from")
  transfers_to      Transfer[] @relation("transfer_to")
  cost_histories    CostHistory[]
  inventory_costs   InventoryCost[]
  store_config      StoreConfig?

  @@map("stores")
}

model User {
  id                String   @id @default(cuid())
  companyId         String
  email             String
  password          String
  name              String
  role              String   @default("cashier")
  is_active         Boolean  @default(true)
  created_at        Int      @default(0)
  updated_at        Int

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales             Sale[]
  inventory_movements InventoryMovement[]
  created_orders    PurchaseOrder[] @relation("created_orders")
  created_receipts  PurchaseReceipt[] @relation("created_receipts")
  created_tasks     Task[] @relation("created_tasks")
  assigned_tasks    Task[] @relation("assigned_tasks")
  completed_tasks   Task[] @relation("completed_tasks")
  created_transfers Transfer[] @relation("created_transfers")
  received_transfers Transfer[] @relation("received_transfers")

  @@unique([companyId, email])
  @@map("users")
}

model Product {
  id                String   @id @default(cuid())
  companyId         String
  storeId           String
  code              String
  name              String
  description       String?
  price_cents       Int
  cost_cents        Int?
  stock_quantity    Int      @default(0)
  sku               String?
  category_id       String?
  metadata          String?
  is_active         Boolean  @default(true)
  created_at        Int      @default(0)
  updated_at        Int

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  inventory         Inventory[]
  inventory_movements InventoryMovement[]
  sale_items        SaleItem[]
  purchase_order_items PurchaseOrderItem[]

  @@unique([companyId, storeId, code])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(cuid())
  companyId         String
  productId         String
  size              String?
  color             String?
  barcode           String?
  sku               String?
  price_cents       Int      @default(0)
  cost_cents        Int?
  is_active         Boolean  @default(true)
  created_at        Int      @default(0)
  updated_at        Int

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory         Inventory[]
  sale_items        SaleItem[]
  inventory_movements InventoryMovement[]
  purchase_order_items PurchaseOrderItem[]
  transfer_items    TransferItem[]
  cost_histories    CostHistory[]
  inventory_costs   InventoryCost[]

  @@unique([companyId, barcode])
  @@map("product_variants")
}

model Inventory {
  id                String   @id @default(cuid())
  companyId         String
  storeId           String
  productId         String
  variantId         String?
  quantity          Int      @default(0)
  min_stock         Int      @default(0)
  max_stock         Int?
  created_at        Int      @default(0)
  updated_at        Int

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantId])
  @@map("inventory")
}

model InventoryMovement {
  id              String   @id @default(cuid())
  companyId       String
  storeId         String
  productId       String
  variantId       String?
  userId          String?
  type            String
  quantity        Int
  reason          String
  reference_type  String?
  reference_id    String?
  created_at      Int      @default(0)

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, storeId])
  @@index([productId])
  @@index([created_at])
  @@map("inventory_movements")
}

model Sale {
  id                String   @id @default(cuid())
  companyId         String
  storeId           String
  cash_register_id  String?
  user_id           String
  contact_id        String?
  ticket_number     Int      @default(0)

  total_cents       Int
  discount_cents    Int      @default(0)
  tax_cents         Int      @default(0)

  status            String   @default("completed")
  payment_method    String
  payment_details   String?

  notes             String?
  synced_at         Int?

  created_at        Int      @default(0)
  updated_at        Int

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items             SaleItem[]
  invoice           Invoice?

  @@index([companyId, storeId])
  @@index([companyId, storeId, ticket_number])
  @@index([created_at])
  @@map("sales")
}

model SaleItem {
  id                String   @id @default(cuid())
  saleId            String
  productId         String
  variantId         String?
  quantity          Int
  unit_price_cents  Int
  total_cents       Int
  discount_cents    Int      @default(0)

  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("sale_items")
}

model Contact {
  id                String   @id @default(cuid())
  companyId         String
  type              String   @default("customer")
  name              String
  email             String?
  phone             String?
  address           String?
  tax_id            String?
  notes             String?
  is_active         Boolean  @default(true)
  balance_cents     Int      @default(0)
  created_at        Int      @default(0)
  updated_at        Int

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchase_orders   PurchaseOrder[] @relation("order_supplier")
  purchase_receipts PurchaseReceipt[] @relation("receipt_supplier")
  wallet_transactions WalletTransaction[]
  supplier_cost_histories CostHistory[] @relation("supplier_cost_history")

  @@map("contacts")
}

model WalletTransaction {
  id                String   @id @default(cuid())
  companyId         String
  contactId         String
  type              String
  amount_cents      Int
  balance_before    Int
  balance_after     Int
  reference         String?
  reference_id      String?
  notes             String?
  created_by        String?
  created_at        Int      @default(0)

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([companyId, contactId])
  @@index([created_at])
  @@map("wallet_transactions")
}

model PurchaseOrder {
  id                String   @id @default(cuid())
  companyId         String
  storeId           String
  supplierId        String
  status            String   @default("draft")
  expected_date     Int?
  notes             String?
  total_cents       Int      @default(0)
  created_by        String
  created_at        Int      @default(0)
  updated_at        Int

  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier          Contact        @relation("order_supplier", fields: [supplierId], references: [id])
  creator           User           @relation("created_orders", fields: [created_by], references: [id])
  items             PurchaseOrderItem[]
  receipts          PurchaseReceipt[]
  cost_histories    CostHistory[]

  @@index([companyId, storeId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  variantId         String?
  quantity_ordered  Int
  quantity_received Int      @default(0)
  unit_cost_cents   Int      @default(0)
  total_cents       Int      @default(0)

  order             PurchaseOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id])
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  cost_histories    CostHistory[]

  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id                String   @id @default(cuid())
  companyId         String
  storeId           String
  orderId           String?
  supplierId        String
  receipt_number    String?
  notes             String?
  created_by        String
  created_at        Int      @default(0)

  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order             PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supplier          Contact        @relation("receipt_supplier", fields: [supplierId], references: [id])
  creator           User           @relation("created_receipts", fields: [created_by], references: [id])

  @@index([companyId, storeId])
  @@map("purchase_receipts")
}

model CashRegister {
  id                String   @id @default(cuid())
  companyId         String
  storeId           String
  name              String
  status            String   @default("closed")
  opening_amount    Int      @default(0)
  closing_amount    Int?
  opened_at         Int?
  closed_at         Int?
  created_at        Int      @default(0)
  updated_at        Int

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  movements         CashMovement[]

  @@map("cash_registers")
}

model CashMovement {
  id                String   @id @default(cuid())
  cashRegisterId    String
  companyId         String
  storeId           String
  type              String
  amount_cents      Int
  description       String
  created_at        Int      @default(0)

  cashRegister      CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("cash_movements")
}

model SyncQueue {
  id                String   @id @default(cuid())
  companyId         String
  storeId           String
  action            String
  entity            String
  entityId          String
  payload           String
  status            String   @default("pending")
  error_message     String?
  synced_at         Int?
  created_at        Int      @default(0)

  @@index([status])
  @@index([companyId, storeId, status])
  @@map("sync_queue")
}

model Task {
  id           String   @id @default(cuid())
  companyId    String
  storeId      String
  title        String
  description  String?
  priority     String   @default("medium")
  status       String   @default("pending")
  due_at       Int?
  created_by   String
  assigned_to  String?
  completed_by String?
  completed_at Int?
  deleted_at   Int?
  created_at   Int      @default(0)
  updated_at   Int

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creator   User    @relation("created_tasks", fields: [created_by], references: [id])
  assignee  User?   @relation("assigned_tasks", fields: [assigned_to], references: [id])
  completer User?   @relation("completed_tasks", fields: [completed_by], references: [id])

  @@index([companyId, storeId, deleted_at])
  @@map("tasks")
}

model Transfer {
  id          String  @id @default(cuid())
  companyId   String
  storeFromId String
  storeToId   String
  status      String  @default("pending")
  created_by  String
  received_by String?
  note        String?
  received_at Int?
  created_at  Int     @default(0)
  updated_at  Int

  storeFrom Store @relation("transfer_from", fields: [storeFromId], references: [id], onDelete: Cascade)
  storeTo   Store @relation("transfer_to", fields: [storeToId], references: [id], onDelete: Cascade)
  creator   User  @relation("created_transfers", fields: [created_by], references: [id])
  receiver  User? @relation("received_transfers", fields: [received_by], references: [id])
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     TransferItem[]

  @@index([companyId, status])
  @@index([companyId, storeFromId])
  @@map("transfers")
}

model TransferItem {
  id                String  @id @default(cuid())
  transferId        String
  variantId         String
  quantity_sent     Int
  quantity_received Int?

  transfer Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@map("transfer_items")
}

model Invoice {
  id               String  @id @default(cuid())
  companyId        String
  saleId           String  @unique
  type             String
  number           String?
  customer_name    String
  customer_tax_id  String
  customer_address String?
  customer_email   String?
  total_cents      Int
  net_amount_cents Int
  tax_amount_cents Int
  cae              String?
  cae_expiration   Int?
  created_at       Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id])

  @@index([companyId, created_at])
  @@index([companyId, number])
  @@map("invoices")
}

model CostHistory {
  id               String  @id @default(cuid())
  companyId        String
  storeId          String
  variantId        String
  supplier_id      String?
  purchase_id      String?
  purchase_item_id String?
  unit_cost_cents  Int
  quantity         Int
  purchased_at     Int

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant        ProductVariant     @relation(fields: [variantId], references: [id])
  supplier       Contact?           @relation("supplier_cost_history", fields: [supplier_id], references: [id])
  purchase       PurchaseOrder?     @relation(fields: [purchase_id], references: [id])
  purchase_item  PurchaseOrderItem? @relation(fields: [purchase_item_id], references: [id])

  @@index([companyId, storeId, variantId, purchased_at])
  @@map("cost_history")
}

model InventoryCost {
  id              String @id @default(cuid())
  companyId       String
  storeId         String
  variantId       String
  avg_cost_cents  Int    @default(0)
  last_cost_cents Int    @default(0)
  updated_at      Int

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([companyId, storeId, variantId])
  @@map("inventory_costs")
}

model StoreConfig {
  id                   String @id @default(cuid())
  storeId              String @unique
  receipt_header       String?
  receipt_footer       String?
  tax_rate_bps         Int    @default(2100)
  credit_surcharge_bps Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_configs")
}
