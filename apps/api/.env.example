# ─────────────────────────────────────────────────────────────
# Arcom API (NestJS) — local development
# Copy to .env: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# SQLite database. Relative paths resolve against the schema directory
# (apps/api/prisma/), not the cwd — so this lands at prisma/dev.db.
# REQUIRED: Prisma reads it from the datasource block in schema.prisma.
DATABASE_URL="file:./dev.db"

# Port for the sidecar backend. Injected by the Tauri launcher in production
# with an ephemeral port; only meaningful when running `pnpm dev` directly.
PORT=3000

# Signing key for the local POS session JWTs.
# REQUIRED in production. The code falls back to "arcom-local-dev-secret"
# (apps/api/src/features/auth/auth.module.ts:16) when unset — never ship that.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Origins allowed to call the API from a browser/WebView, comma-separated.
# Leave unset to use the built-in list, which already covers the Vite dev
# server (1420, 5173), Tauri WebView (tauri://localhost) and the landing
# (4321). Only needed when serving the POS from a different host/port.
# CORS_ALLOWED_ORIGINS="http://localhost:1420,https://app.arcom.com"

# Shared secret the Tauri launcher injects so the desktop app can authenticate
# against the sidecar (header: x-arcom-api-token).
# DO NOT SET THIS for `pnpm dev` — the SidecarTokenGuard is inert when the
# variable is absent, which is what lets the dev server work at all. In
# production the launcher mints and persists this token itself
# (arcom-launcher/src-tauri/src/managers/process.rs:127) and there is no
# .env: it spawns the backend with the env set in code.
# ARCOM_BACKEND_TOKEN=

# Tenant ids used by the demo seed (prisma/seed.ts). Leave empty: the seed
# fills them in after creating the demo company/store. Keep these lines
# uncommented — the seed only rewrites keys it can find an existing
# `KEY=` line for, and it fails silently when the line is absent.
LOCAL_COMPANY_ID=""
LOCAL_STORE_ID=""

# Read-only PostgreSQL connection string to the v1 Xata database.
# Only needed for the one-off migration scripts:
#   pnpm migrate:v1 / pnpm validate:v1
# V1_DATABASE_URL="postgresql://..."
