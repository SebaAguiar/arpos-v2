{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcon",
  "version": "1.0.0",
  "identifier": "com.arcon.desktop",
  "build": {
    "beforeDevCommand": "bash scripts/dev.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter api build && pnpm --filter pos-react build",
    "frontendDist": "../../pos-react/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arcon",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3000 http://127.0.0.1:3000; connect-src 'self' http://localhost:3000 http://127.0.0.1:3000 https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Point of Sale System",
    "longDescription": "Arcon - A modern, offline-first point of sale system for retail businesses",
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0OTFEQzFGNTRCQ0IzQjEKUldTeHM3eFVIOXlSWkhkMGNEWXA3R3NEcmF5RHNRUVhwQktjNlBJUUVKaDIvY3dYSjUwa1dZd3MK",
      "endpoints": [
        "https://api.github.com/repos/SebaAguiar/arpos-v2/releases/latest"
      ],
      "dialog": true
    }
  }
}
