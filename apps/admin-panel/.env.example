# ─────────────────────────────────────────────────────────────
# Arcom Admin Panel (Next.js + PostgreSQL) — local development
# Copy to .env.local: cp .env.example .env.local
# ─────────────────────────────────────────────────────────────
# NOTE: this app talks to POSTGRESQL, not SQLite. Same variable name as
# apps/api, opposite meaning. The POS schema (apps/api/prisma/schema.prisma)
# is SQLite; this one (packages/prisma-schema/prisma/schema.prisma) is
# Postgres. Do not copy a DATABASE_URL between the two apps.

# Connection string for the admin database.
# The defaults below match apps/admin-panel/docker-compose.yml, which runs
# postgres:16-alpine on host port 5436 (not the default 5432).
# Start it first:  docker compose up -d
# Then apply the schema:  pnpm --filter admin-panel db:push
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/admin_panel?schema=public"

# Signing key for the admin session JWTs. Verified in src/middleware.ts.
# There is NO default: if this is unset, every request is treated as
# unauthenticated and the panel is unreachable.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# ── License signing (Ed25519) ──────────────────────────────────
# getPrivateKey() in src/server/license-signer.ts throws
# "LICENSE_PRIVATE_KEY is not configured" when empty, so leaving these blank
# fails loudly instead of signing broken tokens.
#
# BOTH values must come from the SAME key pair, and the public key must be
# the one baked into the POS build via VITE_LICENSE_PUBLIC_KEY
# (apps/pos-react). If they don't match, the POS rejects every license you
# issue and there is no error at signing time — the failure only shows up
# on the customer's machine.
#
# Generate a pair (keep the private key out of git):
#   openssl genpkey -algorithm Ed25519 -out license-private.pem
#   openssl pkey -in license-private.pem -pubout -out license-public.pem
#   # PEM bodies must be stored on a single line with \n escapes, as below
LICENSE_PRIVATE_KEY=""
LICENSE_PUBLIC_KEY=""

# Origins allowed to call this API, comma-separated. Unset falls back to the
# built-in list in src/middleware.ts. Only needed if the panel is served
# from a domain other than the defaults.
# CORS_ALLOWED_ORIGINS="http://localhost:3001,https://arcom.com.ar"
