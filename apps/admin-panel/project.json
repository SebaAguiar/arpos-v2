{
  "name": "admin-panel",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next dev -p 3001",
        "cwd": "apps/admin-panel"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/admin-panel"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/admin-panel/src/**/*.{ts,tsx}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/admin-panel"
      }
    },
    "prisma:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma generate --schema ../../packages/prisma-schema/prisma/schema.prisma",
        "cwd": "apps/admin-panel"
      }
    },
    "prisma:push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma db push --schema ../../packages/prisma-schema/prisma/schema.prisma",
        "cwd": "apps/admin-panel"
      }
    },
    "prisma:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma studio --schema ../../packages/prisma-schema/prisma/schema.prisma",
        "cwd": "apps/admin-panel"
      }
    },
    "prisma:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx ../../packages/prisma-schema/prisma/seed.ts",
        "cwd": "apps/admin-panel"
      }
    }
  },
  "tags": ["scope:admin", "type:app"]
}
