{
  "name": "admin-panel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0 --fix",
    "postinstall": "prisma generate --schema ../../packages/prisma-schema/prisma/schema.prisma",
    "db:push": "prisma db push --schema ../../packages/prisma-schema/prisma/schema.prisma && node scripts/apply-db-invariants.mjs",
    "db:migrate": "prisma migrate dev --schema ../../packages/prisma-schema/prisma/schema.prisma",
    "db:studio": "prisma studio --schema ../../packages/prisma-schema/prisma/schema.prisma",
    "db:seed": "tsx ../../packages/prisma-schema/prisma/seed.ts"
  },
  "dependencies": {
    "@arcom/prisma-schema": "workspace:^",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-query": "^5.64.0",
    "@trpc/client": "^11.0.0",
    "@trpc/next": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.25.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "superjson": "^2.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^16.4.7",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  }
}
