generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS ADMIN ───

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("admin")
  active        Boolean  @default(true)
  createdAt     Int      @default(0)
  updatedAt     Int

  @@map("admin_users")
}

// ─── PLANES ───

model Plan {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  maxDevices        Int      @default(1)
  maxStores         Int      @default(1)
  maxProducts       Int?
  priceMonthlyCents Int      @default(0)
  priceYearlyCents  Int      @default(0)
  currency          String   @default("ARS")
  cloudStorage      Boolean  @default(false)
  syncEnabled       Boolean  @default(false)
  arcaEnabled       Boolean  @default(false)
  reportsAdvanced   Boolean  @default(false)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         Int      @default(0)
  updatedAt         Int

  licenses          License[]
  payments          Payment[]

  @@map("plans")
}

// ─── CLIENTES ───

model Client {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String?
  phone         String?
  company       String?
  taxId         String?
  country       String   @default("AR")
  source        String   @default("in-app")
  lastActiveAt  Int?
  totalDevices  Int      @default(0)
  notes         String?
  createdAt     Int      @default(0)
  updatedAt     Int

  licenses      License[]
  payments      Payment[]
  supportTickets SupportTicket[]

  @@map("clients")
}

// ─── LICENCIAS ───

model License {
  id            String   @id @default(cuid())
  clientId      String
  planId        String
  instanceId    String?  @unique
  key           String   @unique
  status        String   @default("pending")
  activatedAt   Int?
  expiresAt     Int?
  lastSeenAt    Int?
  autoRenew     Boolean  @default(false)
  notes         String?
  createdAt     Int      @default(0)
  updatedAt     Int

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan          Plan     @relation(fields: [planId], references: [id])
  payments      Payment[]

  @@index([instanceId, status])
  @@index([clientId])
  @@index([key])
  @@map("licenses")
}

// ─── PAGOS ───

model Payment {
  id            String   @id @default(cuid())
  clientId      String
  licenseId     String?
  planId        String
  amountCents   Int
  currency      String   @default("ARS")
  method        String
  status        String   @default("pending")
  reference     String?
  period        String?
  notes         String?
  paidAt        Int?
  createdAt     Int      @default(0)

  client        Client   @relation(fields: [clientId], references: [id])
  license       License? @relation(fields: [licenseId], references: [id])
  plan          Plan     @relation(fields: [planId], references: [id])

  @@index([clientId])
  @@index([licenseId])
  @@map("payments")
}

// ─── SOPORTE ───

model SupportTicket {
  id            String   @id @default(cuid())
  clientId      String
  subject       String
  description   String?
  status        String   @default("open")
  priority      String   @default("medium")
  resolvedAt    Int?
  createdAt     Int      @default(0)
  updatedAt     Int

  client        Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([status])
  @@map("support_tickets")
}
