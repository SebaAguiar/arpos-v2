# MercadoPago credentials (sandbox)
MP_ACCESS_TOKEN=TEST-xxxx-xxxx-xxxx-xxxx
MP_PUBLIC_KEY=TEST-xxxx-xxxx-xxxx-xxxx

# Plan IDs from MercadoPago (create plans at https://www.mercadopago.com.ar/subscriptions)
MP_PLAN_ID_PRO=
MP_PLAN_ID_ENTERPRISE=

# Secret from the MercadoPago webhook subscription, used to verify the
# x-signature header on POST /api/webhooks/mercadopago.
# REQUIRED for production: the webhook is fail-closed and returns 503 on
# every request when this is missing, and scripts/check-env.mjs fails the
# production build without it. Never deploy without setting this.
# Read in src/pages/api/webhooks/mercadopago.ts and src/lib/webhook-security.ts.
MP_WEBHOOK_SECRET=
