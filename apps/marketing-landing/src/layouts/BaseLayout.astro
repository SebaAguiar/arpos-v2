---
import '../styles/base.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/layout/Seo.astro';

interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Seo title={title} description={description} noIndex={noIndex} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  </head>
  <body
    class="flex min-h-screen flex-col bg-white text-slate-900 antialiased selection:bg-primary-100 selection:text-primary-900"
  >
    <Header />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
