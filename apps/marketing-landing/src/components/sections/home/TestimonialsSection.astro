---
import { getCollection } from 'astro:content';

const testimonials = await getCollection('testimonials');
---

<section class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-xl text-center">
      <h2 class="text-lg font-semibold leading-8 tracking-tight text-primary-600">Testimonios</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Comercios que crecen con Arcom
      </p>
    </div>
    <div class="mx-auto mt-16 flow-root max-w-2xl sm:mt-20 lg:mx-0 lg:max-w-none">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((testimonial) => (
          <div class="rounded-2xl bg-gray-50 p-6 leading-6 ring-1 ring-gray-900/5">
             <blockquote class="text-gray-900">
              <p>"{testimonial.data.body}"</p>
            </blockquote>
            <div class="mt-6 flex items-center gap-x-4">
              <div class="h-10 w-10 rounded-full bg-gray-200"></div> <!-- Avatar placeholder -->
              <div>
                <div class="font-semibold">{testimonial.data.author.name}</div>
                <div class="text-gray-600 text-sm">{testimonial.data.author.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
