---

---

<section id="features" class="py-24 px-4 md:px-12 bg-[#faf9fc]">
  <div class="max-w-[1280px] mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-[#0b2545] mb-4 tracking-tight">
        Todo lo que necesitas, en un solo lugar
      </h2>
      <p class="text-slate-600 text-lg max-w-2xl mx-auto">
        Módulos integrados diseñados para el alto rendimiento y la facilidad de uso.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Card 1: Punto de Venta -->
      <div class="bg-[#f5f3f6] p-8 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden flex flex-col justify-between group">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-lg bg-[#0b2545]/10 text-[#0b2545] flex items-center justify-center mb-4">
            <span class="material-symbols-outlined">point_of_sale</span>
          </div>
          <h3 class="text-xl font-bold text-[#0b2545] mb-2">Punto de Venta</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Interfaz rápida optimizada para pantallas táctiles, atajos de teclado y lectores de códigos de barras.
          </p>
        </div>
        <div class="mt-4 rounded-xl overflow-hidden border border-slate-300 shadow-sm bg-white">
          <img src="/screenshots/cash-register-light.png" alt="POS UI" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
        </div>
      </div>

      <!-- Card 2: Facturación AFIP / ARCA -->
      <div class="bg-[#f5f3f6] p-8 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden flex flex-col justify-between group">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-lg bg-[#0b2545]/10 text-[#0b2545] flex items-center justify-center mb-4">
            <span class="material-symbols-outlined">receipt_long</span>
          </div>
          <h3 class="text-xl font-bold text-[#0b2545] mb-2">Facturación ARCA / AFIP</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Comprobantes electrónicos A, B y C en un clic. Emisión automática de CAE y reintento si AFIP está caído.
          </p>
        </div>
        <div class="mt-4 rounded-xl overflow-hidden border border-slate-300 shadow-sm bg-white">
          <img src="/screenshots/payment-dialog-light.png" alt="Payment Dialog UI" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
        </div>
      </div>

      <!-- Card 3: Control de Inventario -->
      <div class="bg-[#f5f3f6] p-8 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden flex flex-col justify-between group">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-lg bg-[#0b2545]/10 text-[#0b2545] flex items-center justify-center mb-4">
            <span class="material-symbols-outlined">inventory_2</span>
          </div>
          <h3 class="text-xl font-bold text-[#0b2545] mb-2">Control de Inventario</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Gestión de stock, variantes (talle/color), alertas de faltantes e historial de movimientos.
          </p>
        </div>
        <div class="mt-4 rounded-xl overflow-hidden border border-slate-300 shadow-sm bg-white">
          <img src="/screenshots/inventory-light.png" alt="Inventory UI" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
        </div>
      </div>

      <!-- Card 4: Sincronización Multi-Sucursal -->
      <div class="bg-[#f5f3f6] p-8 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden flex flex-col justify-between group">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-lg bg-[#0b2545]/10 text-[#0b2545] flex items-center justify-center mb-4">
            <span class="material-symbols-outlined">cloud_sync</span>
          </div>
          <h3 class="text-xl font-bold text-[#0b2545] mb-2">Sync Cloud Multi-Sucursal</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Centralizá múltiples locales en la nube sin perder velocidad ni autonomía de venta local.
          </p>
        </div>
        <div class="mt-4 rounded-xl overflow-hidden border border-slate-300 shadow-sm bg-white">
          <img src="/screenshots/cloud-sync-light.png" alt="Cloud Sync UI" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
        </div>
      </div>

      <!-- Card 5: Caja y Arqueos -->
      <div class="bg-[#f5f3f6] p-8 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden flex flex-col justify-between group">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-lg bg-[#0b2545]/10 text-[#0b2545] flex items-center justify-center mb-4">
            <span class="material-symbols-outlined">analytics</span>
          </div>
          <h3 class="text-xl font-bold text-[#0b2545] mb-2">Caja & Reportes Diarios</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Arqueos ciegos de caja, cierres Z/X, control de ingresos/egresos y métricas en tiempo real.
          </p>
        </div>
        <div class="mt-4 rounded-xl overflow-hidden border border-slate-300 shadow-sm bg-white">
          <img src="/screenshots/reports-light.png" alt="Reports UI" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
        </div>
      </div>

      <!-- Card 6: Clientes y Cuentas Corrientes -->
      <div class="bg-[#f5f3f6] p-8 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden flex flex-col justify-between group">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-lg bg-[#0b2545]/10 text-[#0b2545] flex items-center justify-center mb-4">
            <span class="material-symbols-outlined">group</span>
          </div>
          <h3 class="text-xl font-bold text-[#0b2545] mb-2">Clientes y Fiados</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Historial de compras, cuenta corriente con límite de crédito y facturación recurrente.
          </p>
        </div>
        <div class="mt-4 rounded-xl overflow-hidden border border-slate-300 shadow-sm bg-white">
          <img src="/screenshots/customers-light.png" alt="Customers UI" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
        </div>
      </div>
    </div>
  </div>
</section>
