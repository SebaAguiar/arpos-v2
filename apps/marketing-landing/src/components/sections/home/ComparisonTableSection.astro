---

---

<section class="py-24 px-4 md:px-12 bg-[#faf9fc]">
  <div class="max-w-[1280px] mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-[#0b2545] mb-4 tracking-tight">
        No todos los sistemas son iguales
      </h2>
      <p class="text-slate-600 text-lg max-w-2xl mx-auto">
        Mirá cómo se compara Arcon con las alternativas del mercado.
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <thead>
          <tr class="bg-[#0b2545] text-white">
            <th class="p-4 md:p-6 text-sm font-bold">Característica</th>
            <th class="p-4 md:p-6 text-sm font-bold bg-[#10B981] text-white">Arcon POS (Local-First)</th>
            <th class="p-4 md:p-6 text-sm font-bold opacity-90">Sistemas Web SaaS</th>
            <th class="p-4 md:p-6 text-sm font-bold opacity-90">Software Escritorio Legacy</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 text-sm text-slate-700">
          <tr>
            <td class="p-4 md:p-6 font-semibold text-[#0b2545]">Funciona sin internet</td>
            <td class="p-4 md:p-6 font-bold text-emerald-600 bg-emerald-50/50">✓ 100% Autónomo en PC</td>
            <td class="p-4 md:p-6 text-rose-500 font-semibold">✕ Se detiene la caja</td>
            <td class="p-4 md:p-6 text-slate-600">✓ Sí, pero no sincroniza</td>
          </tr>
          <tr>
            <td class="p-4 md:p-6 font-semibold text-[#0b2545]">Facturación ARCA / AFIP</td>
            <td class="p-4 md:p-6 font-bold text-emerald-600 bg-emerald-50/50">✓ Reintento Offline automático</td>
            <td class="p-4 md:p-6 text-amber-600">⚠ Falla si colapsa la red</td>
            <td class="p-4 md:p-6 text-slate-600">⚠ Requiere ticketeras viejas</td>
          </tr>
          <tr>
            <td class="p-4 md:p-6 font-semibold text-[#0b2545]">Sync Multi-Sucursal</td>
            <td class="p-4 md:p-6 font-bold text-emerald-600 bg-emerald-50/50">✓ Automático en 2º plano</td>
            <td class="p-4 md:p-6 text-emerald-600">✓ Sí, en la nube</td>
            <td class="p-4 md:p-6 text-rose-500 font-semibold">✕ Manual / Archivos sueltos</td>
          </tr>
          <tr>
            <td class="p-4 md:p-6 font-semibold text-[#0b2545]">Velocidad de cobro</td>
            <td class="p-4 md:p-6 font-bold text-emerald-600 bg-emerald-50/50">⚡ &lt;5ms (SQLite local)</td>
            <td class="p-4 md:p-6 text-slate-600">⏳ Depende de la latencia web</td>
            <td class="p-4 md:p-6 text-slate-600">🐢 Lento / DBs pesadas</td>
          </tr>
          <tr>
            <td class="p-4 md:p-6 font-semibold text-[#0b2545]">Instalación y Setup</td>
            <td class="p-4 md:p-6 font-bold text-emerald-600 bg-emerald-50/50">⚡ Zero-Config (&lt;3 min)</td>
            <td class="p-4 md:p-6 text-emerald-600">✓ Registro rápido web</td>
            <td class="p-4 md:p-6 text-rose-500 font-semibold">✕ Requiere técnico presencial</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
