---

---

<section id="pricing" class="py-24 px-4 md:px-12 bg-[#f5f3f6] border-y border-slate-200">
  <div class="max-w-[1280px] mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-[#0b2545] mb-4 tracking-tight">
        Planes claros, sin sorpresas
      </h2>
      <p class="text-slate-600 text-lg max-w-2xl mx-auto">
        Elegí el plan perfecto para escalar tu comercio o franquicia.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <!-- Plan Inicial -->
      <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <h3 class="text-xl font-bold text-[#0b2545] mb-2">Comercio Solo</h3>
          <p class="text-slate-500 text-xs mb-6">Ideal para 1 local o caja única</p>
          <div class="text-4xl font-extrabold text-[#0b2545] mb-6">
            $24.900 <span class="text-xs font-normal text-slate-500">/mes</span>
          </div>
          <ul class="space-y-3 text-xs text-slate-600 mb-8">
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> POS Local-First 100% Offline
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Facturación ARCA / AFIP ilimitada
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> 1 Sucursal / 1 Terminal
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Control de Caja y Stock básico
            </li>
          </ul>
        </div>
        <a href="#register" class="w-full py-3 text-center font-bold text-sm text-[#0b2545] bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
          Comenzar prueba
        </a>
      </div>

      <!-- Plan Pro (Destacado) -->
      <div class="bg-[#0b2545] text-white p-8 rounded-2xl border border-[#0b2545] shadow-xl relative flex flex-col justify-between ring-2 ring-[#10B981]">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-[#10B981] text-white text-2xs font-extrabold tracking-wider uppercase shadow-sm">
          Más Popular
        </div>
        <div>
          <h3 class="text-xl font-bold mb-2">Multi-Sucursal</h3>
          <p class="text-slate-300 text-xs mb-6">Para negocios en expansión</p>
          <div class="text-4xl font-extrabold mb-6">
            $49.900 <span class="text-xs font-normal text-slate-300">/mes</span>
          </div>
          <ul class="space-y-3 text-xs text-slate-200 mb-8">
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Todo lo del plan Comercio
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Hasta 5 Sucursales conectadas
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Sync Queue automática en la nube
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Transferencias de stock e historial
            </li>
          </ul>
        </div>
        <a href="#register" class="w-full py-3 text-center font-bold text-sm text-white bg-[#10B981] hover:bg-emerald-600 rounded-lg transition-colors shadow-md">
          Probar gratis 14 días
        </a>
      </div>

      <!-- Plan Enterprise -->
      <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <h3 class="text-xl font-bold text-[#0b2545] mb-2">Franquicias & Redes</h3>
          <p class="text-slate-500 text-xs mb-6">Grandes cadenas y mayoristas</p>
          <div class="text-4xl font-extrabold text-[#0b2545] mb-6">
            A medida
          </div>
          <ul class="space-y-3 text-xs text-slate-600 mb-8">
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Sucursales y cajas ilimitadas
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Servidor de sincronización dedicado
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Soporte prioritario 24/7 y SLA
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#10B981] font-bold">✓</span> Integraciones custom ERP / API
            </li>
          </ul>
        </div>
        <a href="#contact" class="w-full py-3 text-center font-bold text-sm text-[#0b2545] bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
          Contactar Ventas
        </a>
      </div>
    </div>
  </div>
</section>
