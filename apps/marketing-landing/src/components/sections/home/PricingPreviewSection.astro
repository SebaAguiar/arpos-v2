---
import { PLANS } from '../../../data/plans';
---

<section id="pricing" class="py-24 px-4 md:px-12 bg-sand border-y border-sand/50">
  <div class="max-w-[1280px] mx-auto">
    <div class="text-center mb-16">
      <div class="text-terra-700 font-semibold text-sm mb-4 uppercase tracking-wider flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-base">sell</span>
        PLANES Y PRECIOS
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-ink mb-4 tracking-tight">
        Planes claros, sin sorpresas
      </h2>
      <p class="text-stone text-lg max-w-2xl mx-auto">
        Empezá gratis. Escalá cuando tu negocio lo necesite.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      {PLANS.map((plan) => (
        <div class:list={[
          'p-8 rounded-2xl shadow-sm flex flex-col justify-between',
          plan.highlighted
            ? 'bg-ink text-white border border-ink shadow-xl relative ring-2 ring-terra-600'
            : 'bg-white border border-sand/50',
        ]}>
          {plan.highlighted && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-terra-600 text-white text-2xs font-extrabold tracking-wider uppercase shadow-sm">
              Más Popular
            </div>
          )}
          <div>
            <h3 class:list={['text-xl font-bold mb-2', plan.highlighted ? '' : 'text-ink']}>
              {plan.name}
            </h3>
            <p class:list={['text-xs mb-6', plan.highlighted ? 'text-sand/70' : 'text-stone']}>
              {plan.description}
            </p>
            <div class:list={['text-4xl font-extrabold mb-6', plan.highlighted ? '' : 'text-ink']}>
              {plan.price === 0 ? (
                'Gratis'
              ) : (
                <>
                  ${plan.price.toLocaleString('es-AR')} <span class:list={['text-xs font-normal', plan.highlighted ? 'text-sand/70' : 'text-stone']}>/mes</span>
                </>
              )}
            </div>
            <ul class:list={['space-y-3 text-xs mb-8', plan.highlighted ? 'text-sand/50' : 'text-stone']}>
              {plan.features.map((feature) => (
                <li class="flex items-center gap-2">
                  <span class:list={['font-bold', plan.highlighted ? 'text-terra-300' : 'text-terra-700']}>✓</span> {feature}
                </li>
              ))}
            </ul>
          </div>
          {plan.price === 0 ? (
            <button
              type="button"
              data-plan={plan.id}
              data-free="true"
              class="checkout-btn w-full py-3 text-center font-bold text-sm rounded-lg transition-colors text-ink bg-sand/30 hover:bg-sand/50 cursor-pointer"
            >
              Registrate gratis
            </button>
          ) : (
            <button
              type="button"
              data-plan={plan.id}
              class="checkout-btn w-full py-3 text-center font-bold text-sm text-white bg-terra-600 hover:bg-terra-700 rounded-lg transition-colors shadow-md cursor-pointer"
            >
              {plan.trialDays > 0 ? `Probar gratis ${plan.trialDays} días` : 'Suscribirse'}
            </button>
          )}
        </div>
      ))}
    </div>
  </div>

  {/* Email modal for checkout */}
  <div id="checkout-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4 relative">
      <button type="button" id="close-modal" class="absolute top-4 right-4 text-stone hover:text-stone">
        <span class="material-symbols-outlined">close</span>
      </button>
      <h3 class="text-xl font-bold text-ink mb-2">Completá tu suscripción</h3>
      <p class="text-stone text-sm mb-6">Ingresá tu email para continuar con el pago en MercadoPago.</p>
      <form id="checkout-form" class="space-y-4">
        <input type="hidden" name="planId" id="checkout-plan-id" />
        <div>
          <label for="checkout-email" class="block text-sm font-medium text-ink mb-1">Email</label>
          <input
            type="email"
            name="email"
            id="checkout-email"
            required
            placeholder="tu@email.com"
            class="w-full px-4 py-3 rounded-lg border border-stone focus:ring-2 focus:ring-terra-600 focus:border-transparent outline-none text-sm"
          />
        </div>
        <button
          type="submit"
          class="w-full py-3 bg-terra-600 hover:bg-terra-700 text-white font-bold text-sm rounded-lg transition-colors"
        >
          Continuar
        </button>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('checkout-modal') as HTMLDivElement;
    const form = document.getElementById('checkout-form') as HTMLFormElement;
    const planInput = document.getElementById('checkout-plan-id') as HTMLInputElement;
    const closeBtn = document.getElementById('close-modal') as HTMLButtonElement;

    document.querySelectorAll('.checkout-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const planId = (btn as HTMLElement).dataset.plan;
        if (planId) {
          planInput.value = planId;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const planId = formData.get('planId') as string;
      const email = formData.get('email') as string;

      const isFree = document.querySelector(`[data-plan="${planId}"]`)?.getAttribute('data-free') === 'true';

      try {
        if (isFree) {
          const res = await fetch('/api/signup-free', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });

          const data = await res.json();
          if (data.success) {
            window.location.href = '/suscripcion/exito?plan=free';
          } else {
            alert(data.error || 'Error al registrar. Intentá de nuevo.');
          }
        } else {
          const res = await fetch('/api/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              planId,
              payerEmail: email,
              backUrl: window.location.origin + '/suscripcion/exito',
            }),
          });

          const data = await res.json();
          if (data.initPoint) {
            window.location.href = data.initPoint;
          } else {
            alert('Error al crear la suscripción. Intentá de nuevo.');
          }
        }
      } catch {
        alert('Error de conexión. Intentá de nuevo.');
      }
    });
  </script>
</section>
