---
interface Props {
  variant?: 'default' | 'neutral' | 'success' | 'warning' | 'error';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants = {
  default: 'bg-primary-50 text-primary-700 ring-primary-600/20',
  neutral: 'bg-gray-50 text-gray-600 ring-gray-500/10',
  success: 'bg-green-50 text-green-700 ring-green-600/20',
  warning: 'bg-yellow-50 text-yellow-800 ring-yellow-600/20',
  error: 'bg-red-50 text-red-700 ring-red-600/10',
};

const baseStyles =
  'inline-flex items-center rounded-full px-2 py-1 text-xs font-medium ring-1 ring-inset';
---

<span class:list={[baseStyles, variants[variant], className]}>
  <slot />
</span>
