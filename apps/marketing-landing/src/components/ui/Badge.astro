---
interface Props {
  variant?: 'default' | 'neutral' | 'success' | 'warning' | 'error';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants = {
  default: 'bg-primary-100 text-primary-900 ring-primary-600/20',
  neutral: 'bg-sand text-stone ring-stone/20',
  // Ruta C has a single accent, so "success" is expressed with terracotta and
  // "warning" with neutral stone. Introducing a second hue here would put a
  // green chip next to a terracota CTA on the same screen.
  success: 'bg-terra-100 text-terra-800 ring-terra-600/20',
  warning: 'bg-sand text-stone ring-stone/20',
  error: 'bg-alert-100 text-alert-800 ring-alert-600/20',
};

const baseStyles =
  'inline-flex items-center rounded-full px-2 py-1 text-xs font-medium ring-1 ring-inset';
---

<span class:list={[baseStyles, variants[variant], className]}>
  <slot />
</span>
