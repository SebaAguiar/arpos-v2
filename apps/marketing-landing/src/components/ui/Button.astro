---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  ...rest
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center rounded-lg font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none';

const variants = {
  // Board rule: primary CTA on light = ink background with sand text (15.3:1).
  // `bg-primary-600` was #85796d, which only reached 4.24:1 with white text.
  primary:
    'bg-ink text-sand hover:bg-primary-900 focus:ring-terra-600',
  secondary:
    'bg-sand text-ink hover:bg-sand/60 focus:ring-terra-600',
  outline:
    'border border-line bg-transparent text-ink hover:bg-sand/40 focus:ring-stone',
  ghost:
    'bg-transparent text-stone hover:bg-sand/60 hover:text-ink focus:ring-stone',
};

const sizes = {
  sm: 'h-8 px-3 text-xs',
  md: 'h-10 px-4 py-2 text-sm',
  lg: 'h-12 px-6 text-base',
};

const styles = [baseStyles, variants[variant], sizes[size], className].join(
  ' ',
);

const Element = href ? 'a' : 'button';
---

<Element href={href} class={styles} {...rest}>
  <slot />
</Element>
