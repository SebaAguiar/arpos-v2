---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturesSection from '../components/sections/home/FeaturesSection.astro';
import MultiStoreSection from '../components/sections/home/MultiStoreSection.astro';
import EcommerceSection from '../components/sections/home/EcommerceSection.astro';
import ArcaSection from '../components/sections/home/ArcaSection.astro';
import FinalCTASection from '../components/sections/home/FinalCTASection.astro';
---

<BaseLayout
  title="Funcionalidades - Arcon"
  description="Descubrí todo lo que Arcon puede hacer por tu negocio. Gestión de stock, ventas, facturación y más."
>
  <div class="pt-24 bg-gray-900">
    <div class="px-6 py-24 sm:py-32 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
          Todo lo que necesitás para crecer
        </h2>
        <p class="mt-6 text-lg leading-8 text-gray-300">
          Arcon es una plataforma completa diseñada para modernizar la gestión
          de tu comercio.
        </p>
      </div>
    </div>
    <FeaturesSection />
    <MultiStoreSection />
    <EcommerceSection />
    <ArcaSection />
    <FinalCTASection />
  </div>
</BaseLayout>
